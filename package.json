{
  "name": "tweetshelf",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute tweetshelf --remote --file schema.sql",
    "db:init:local": "wrangler d1 execute tweetshelf --local --file schema.sql",
    "db:seed:local": "node scripts/seed-local.cjs",
    "shots": "node scripts/screenshots.cjs"
  },
  "devDependencies": {
    "wrangler": "4.149.0"
  }
}
